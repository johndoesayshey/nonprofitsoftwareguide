# Copy to .env and fill in when you have the values. All are optional — the site
# builds and runs fine with them empty. Only PUBLIC_-prefixed vars reach the browser.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA.
PUBLIC_GA4_ID=

# Google Search Console verification token (the content="..." value from the
# "HTML tag" verification method). Leave empty until you verify the property.
PUBLIC_GSC_VERIFICATION=
