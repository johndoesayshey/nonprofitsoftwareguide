---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryHub from '../../components/CategoryHub.astro';
import { CATEGORIES } from '../../lib/categories';
const meta = CATEGORIES['grant-research'];
---
<BaseLayout title="Grant research software" description={meta.blurb} section="grant">
  <div class="wrap">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Grant research' }]} />
    <section class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">Category</p>
      <h1>Grant research software</h1>
      <p class="lede">{meta.blurb}</p>
    </section>
    <CategoryHub category="grant-research" />
  </div>
</BaseLayout>
