---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { formatLong } from '../lib/dates';
import { CATEGORIES } from '../lib/categories';
import { STACK_TIERS } from '../lib/stacks';

// Every figure on this page is read straight off the four stack pages at build
// time. They were maintained as two separate lists and drifted apart within a
// week; now there is one source and the table cannot contradict the pages it
// summarises.
const stacks = await getCollection('stacks', ({ data }) => data.draft === false);
const bySlug = new Map(stacks.map((s) => [s.data.slug, s.data]));

const tiers = STACK_TIERS.filter((t) => bySlug.has(t.slug));
const categories = Object.values(CATEGORIES);
const ready = tiers.length > 0;

// Most recent verification across the stacks it is built from.
const updated = new Date(Math.max(...stacks.map((s) => +s.data.lastVerified)));
const updatedLabel = formatLong(updated);

function cell(tierSlug: string, categorySlug: string): string {
  const line = bySlug.get(tierSlug)?.components.find((c) => c.category === categorySlug);
  // No line at all means the stack deliberately leaves this category out.
  if (!line) return '—';
  return line.annualCost;
}

const site = Astro.site ?? new URL('https://nonprofitsoftwareguide.com');
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Nonprofit fundraising software spend benchmark',
  description:
    'What nonprofits at each shop size ($250k to $5M+) typically spend per year on fundraising software, by category.',
  url: new URL('/benchmarks/', site).href,
  creator: { '@type': 'Organization', name: 'Nonprofit Software Guide' },
  dateModified: updated.toISOString(),
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="Nonprofit fundraising software spend benchmark"
  description="What nonprofits at each shop size actually spend per year on fundraising software, by category. An annual benchmark."
  section="benchmark"
  noindex={!ready}>
  <div class="wrap">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Benchmark' }]} />

    {!ready && (
      <aside class="draft-banner" role="note">
        <strong>No published stacks yet.</strong> This table is built from the stack
        pages, and none are published, so there is nothing to show.
      </aside>
    )}

    <article class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">Annual benchmark · original data</p>
      <h1>What nonprofits spend on fundraising software</h1>

      <p class="lede">
        What a fundraising operation costs to run at each size, category by
        category, on one page. Every figure is the line item from that shop
        size's recommended stack, so you can take a column straight into a
        budget conversation. A dash means that category is deliberately left out
        at that size. Click a column heading for the reasoning behind each line.
      </p>

      <p class="benchmark-updated"><span class="verified">Updated {updatedLabel}</span></p>

      <div class="table-scroll">
        <table class="benchmark">
          <thead>
            <tr>
              <th scope="col">Category</th>
              {tiers.map((t) => (
                <th scope="col" class="num">
                  <a href={`/stacks/${t.slug}/`}>{t.tier}</a><br /><small>{t.revenue} raised</small>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {categories.map((c) => (
              <tr>
                <th scope="row">{c.path ? <a href={c.path}>{c.label}</a> : c.label}</th>
                {tiers.map((t) => {
                  const v = cell(t.slug, c.slug);
                  return <td class:list={['num', { none: v === '—' }]}>{v}</td>;
                })}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total per year</th>
              {tiers.map((t) => <td class="num">{bySlug.get(t.slug)?.totalStackCost}</td>)}
            </tr>
          </tfoot>
        </table>
      </div>

      <p>
        To see the tools behind these numbers, read the
        <a href="/">recommended stack for your shop size</a>.
      </p>
    </article>
  </div>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(datasetLd)} is:inline />
</BaseLayout>

<style>
  .benchmark td.none { color: var(--color-muted); font-weight: 500; }
  .benchmark thead a, .benchmark tbody th a { color: inherit; text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong); }
  .benchmark thead a:hover, .benchmark tbody th a:hover { color: var(--color-green-deep); }

  .draft-banner { border: 2px dashed var(--color-red); color: var(--color-red);
    background: #fbeeee; padding: .7rem 1rem; margin: 1rem 0; font-size: .9rem;
    font-family: var(--font-mono); border-radius: 2px; }
  .draft-banner strong { font-family: var(--font-serif); }
  .draft-banner code { background: rgba(0,0,0,.06); padding: .05em .3em; border-radius: 2px; }
  .benchmark-updated { margin: 0 0 1rem; }
  .table-scroll { overflow-x: auto; margin: 1.2rem 0; }
  table.benchmark { min-width: 40rem; }
  table.benchmark th[scope="row"] { white-space: nowrap; }
  table.benchmark tfoot th, table.benchmark tfoot td { border-top: 2px solid var(--color-ink); font-weight: 700; }
  table.benchmark small { font-weight: 400; color: var(--color-muted); }
</style>
