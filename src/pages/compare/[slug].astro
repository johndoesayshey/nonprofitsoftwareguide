---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import { comparePairs } from '../../lib/compare';
import { categoryLabel, bestForIn } from '../../lib/categories';
import { getAffiliate } from '../../lib/affiliates';
import { formatMonthYear } from '../../lib/dates';

export async function getStaticPaths() {
  const pairs = await comparePairs();
  return pairs.map((pair) => ({ params: { slug: pair.slug }, props: { pair } }));
}

const { pair } = Astro.props;
// Names for the "not the fit?" links, so a slug typo shows up as the raw slug
// rather than a plausible-looking wrong label.
const allPlatformEntries = await getCollection('platforms');
const platformName = new Map(allPlatformEntries.map((x) => [x.data.slug, x.data.name]));

const a = pair.a.data;
const b = pair.b.data;
const catLabel = categoryLabel(pair.category);

// A comparison is unverified if either side is still a draft.
const isDraft = a.draft !== false || b.draft !== false;

const affA = a.affiliateSlug ? getAffiliate(a.affiliateSlug) : undefined;
const affB = b.affiliateSlug ? getAffiliate(b.affiliateSlug) : undefined;
const fmt = formatMonthYear;

const site = Astro.site ?? new URL('/', Astro.url);
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${a.name} vs ${b.name}`,
  itemListElement: [a, b].map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: new URL(`/platforms/${p.slug}/`, site).href,
  })),
};

const rows: Array<[string, string, string]> = [
  ['Entry price', a.entryPrice, b.entryPrice],
  ['Pricing model', a.pricingModel, b.pricingModel],
  ['Best for', bestForIn(a, pair.category), bestForIn(b, pair.category)],
  ['Last verified', fmt(a.lastVerified), fmt(b.lastVerified)],
];
---

<BaseLayout
  title={`${a.name} vs ${b.name}`}
  description={`${a.name} vs ${b.name}: price, pricing model, and fit. Which one fits your shop.`}
  section="compare"
  noindex={isDraft}>
  <div class="wrap">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Compare', href: '/compare/' },
      { label: `${a.name} vs ${b.name}` },
    ]} />

    {isDraft && <DraftBanner />}

    <article class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">{catLabel} · head to head</p>
      <h1>{a.name} vs {b.name}</h1>

      <!--
        Answer first, assembled from real fields, not invented.

        Only short fields get spliced into the sentence. The previous version
        lowercased each product's whole "best for" paragraph and joined the two
        with a semicolon, which turned CRM into "crm" and Mailchimp into
        "mailchimp", and produced ".;" and ".." wherever the source text already
        ended in a period. Both paragraphs render verbatim in the table below,
        so the intro does not need to repeat them.
      -->
      <p class="lead">
        {a.name} and {b.name} both sit in {catLabel}.
        {a.name}: {a.entryPrice}. {b.name}: {b.entryPrice}.
        The table below lines up pricing model and fit, each in the product's own
        terms, so you can see which one matches your shop.
      </p>

      <AffiliateDisclosure />


      <table>
        <thead>
          <tr><th></th><th>{a.name}</th><th>{b.name}</th></tr>
        </thead>
        <tbody>
          {rows.map(([label, av, bv]) => (
            <tr><th scope="row">{label}</th><td>{av}</td><td>{bv}</td></tr>
          ))}
        </tbody>
      </table>

      <div class="verdicts">
        <div class="verdict">
          <h3>{a.name}</h3>
          <p><strong>Strengths:</strong> {a.strengths.join('; ')}.</p>
          <p><strong>Not the fit?</strong></p>
          <ul class="alt-list">
            {a.otherOptions.filter((o) => o.platformSlug).slice(0, 2).map((o) => (
              <li>{o.need} <a href={`/platforms/${o.platformSlug}/`}>{platformName.get(o.platformSlug) ?? o.platformSlug} →</a></li>
            ))}
          </ul>
          <p><a href={`/platforms/${a.slug}/`}>Full {a.name} write-up →</a></p>
          {affA && <p>{a.affiliateSlug && <AffiliateLink slug={a.affiliateSlug} text={`Try ${a.name}`} />}</p>}
        </div>
        <div class="verdict">
          <h3>{b.name}</h3>
          <p><strong>Strengths:</strong> {b.strengths.join('; ')}.</p>
          <p><strong>Not the fit?</strong></p>
          <ul class="alt-list">
            {b.otherOptions.filter((o) => o.platformSlug).slice(0, 2).map((o) => (
              <li>{o.need} <a href={`/platforms/${o.platformSlug}/`}>{platformName.get(o.platformSlug) ?? o.platformSlug} →</a></li>
            ))}
          </ul>
          <p><a href={`/platforms/${b.slug}/`}>Full {b.name} write-up →</a></p>
          {affB && <p>{b.affiliateSlug && <AffiliateLink slug={b.affiliateSlug} text={`Try ${b.name}`} />}</p>}
        </div>
      </div>
    </article>
  </div>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd)} is:inline />
</BaseLayout>

<style>
  .alt-list { margin: .2rem 0 .6rem; padding-left: 1.1rem; font-size: .93rem; }
  .alt-list li { margin-bottom: .3rem; color: var(--color-muted); }

  .lead { font-size: 1.15rem; color: var(--color-muted); }
  .verdicts { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.4rem; margin: 1.6rem 0; }
  .verdict { border: 1px solid var(--color-rule-strong); border-radius: 2px; padding: 1rem 1.1rem; background: var(--color-paper-2); }
  .verdict h3 { margin-top: 0; }
</style>
