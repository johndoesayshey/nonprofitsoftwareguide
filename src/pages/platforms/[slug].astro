---
import { getCollection, render } from 'astro:content';
import { relFor } from '../../lib/affiliate-value';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import { CATEGORIES } from '../../lib/categories';
import { getAffiliate } from '../../lib/affiliates';

export async function getStaticPaths() {
  const platforms = await getCollection('platforms');
  return platforms.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

// Names for the "other options" links, so a slug change surfaces as a build error
// rather than a wrong label.
const allPlatforms = await getCollection('platforms');
const platformName = new Map(allPlatforms.map((x) => [x.data.slug, x.data.name]));

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const cat = CATEGORIES[p.category];
const affiliate = p.affiliateSlug ? getAffiliate(p.affiliateSlug) : undefined;
const isDraft = p.draft !== false;

// Screenshot slot: drop a product screenshot at public/images/platforms/<slug>.png
// (or .webp / .jpg) and it renders automatically with SEO-friendly alt text.
const pubDir = fileURLToPath(new URL('../../../public', import.meta.url));
const shot = ['png', 'webp', 'jpg'].map((ext) => `/images/platforms/${p.slug}.${ext}`)
  .find((rel) => existsSync(pubDir + rel));

// Product JSON-LD. Only attach clean data — never placeholder strings.
const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  category: cat?.label ?? p.category,
  description: p.bestFor,
  brand: { '@type': 'Brand', name: p.name },
  ...(shot ? { image: new URL(shot, Astro.site ?? Astro.url).href } : {}),
};
---

<BaseLayout
  title={`${p.name} review & pricing`}
  description={`${p.name} for nonprofits: pricing, who it fits, and how it compares. ${p.bestFor}.`}
  ogType="product"
  section={p.category}
  noindex={isDraft}>
  <div class="wrap">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: cat?.label ?? p.category, href: cat?.path },
      { label: p.name },
    ]} />

    {isDraft && <DraftBanner />}

    <article class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">{cat?.label ?? p.category}</p>
      <h1>{p.name}</h1>

      <AffiliateDisclosure />

      <div class="pricebox">
        <div>
          <span class="pricebox-label">Starting price</span>
          <span class="pricebox-value">{p.entryPrice}</span>
        </div>
        <div>
          <span class="pricebox-label">Pricing model</span>
          <span class="pricebox-value">{p.pricingModel}</span>
        </div>
        <div>
          <span class="pricebox-label">Free tier</span>
          <span class="pricebox-value">{p.freeTier ? 'Yes' : 'No'}</span>
        </div>
        {affiliate && p.affiliateSlug && (
          <div class="pricebox-cta">
            <a class="btn-primary" href={`/go/${p.affiliateSlug}`} rel={relFor(p.affiliateSlug)}>
              Visit {p.name} →
            </a>
            {affiliate.readerOffer && <span class="offer">{affiliate.readerOffer}</span>}
          </div>
        )}
      </div>

      {shot && (
        <figure class="shot">
          <img src={shot} alt={`${p.name} dashboard screenshot showing the main ${cat?.label.toLowerCase() ?? ''} workspace`} loading="lazy" decoding="async" />
          <figcaption>Inside {p.name}.</figcaption>
        </figure>
      )}

      <Content />

      <h2>Strengths</h2>
      <ul>{p.strengths.map((s) => <li>{s}</li>)}</ul>

      <h2>Other options</h2>
      <ul class="alts">
        {p.otherOptions.map((o) => (
          <li>
            <strong>{o.need}</strong> {o.note}
            {o.platformSlug && (
              <> <a href={`/platforms/${o.platformSlug}/`}>Read our {platformName.get(o.platformSlug) ?? o.platformSlug} write-up →</a></>
            )}
          </li>
        ))}
      </ul>

      {affiliate && p.affiliateSlug && (
        <p class="cta">
          <a class="btn-primary" href={`/go/${p.affiliateSlug}`} rel={relFor(p.affiliateSlug)}>
            See {p.name} pricing & book a demo →
          </a>
        </p>
      )}
    </article>
  </div>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productLd)} is:inline />
</BaseLayout>

<style>
  .alts li { margin-bottom: .6rem; }
  .alts strong { color: var(--color-ink); }

  .pricebox { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .9rem 1.4rem;
    border: 1px solid var(--color-rule-strong); border-left: 3px solid var(--color-green);
    background: var(--color-paper-2); padding: 1.1rem 1.2rem; margin: 1.4rem 0; border-radius: 2px;
    align-items: center; }
  .pricebox-label { display: block; font-size: .68rem; letter-spacing: .1em; font-weight: 700;
    text-transform: uppercase; color: var(--color-muted); }
  .pricebox-value { display: block; font-size: 1.02rem; margin-top: .15rem; }
  .pricebox-cta { display: flex; flex-direction: column; gap: .3rem; align-items: flex-start; }
  .btn-primary { display: inline-block; background: var(--color-green-deep); color: #fff !important;
    font-weight: 700; text-decoration: none; padding: .55rem .95rem; border-radius: 3px; font-size: .95rem; }
  .btn-primary:hover { background: var(--color-green); }
  .offer { font-size: .78rem; font-weight: 700; color: var(--color-green-deep); }
  .shot { margin: 1.4rem 0; }
  .shot img { max-width: 100%; height: auto; border: 1px solid var(--color-rule); border-radius: 4px;
    box-shadow: 0 10px 24px -18px rgba(0,0,0,.4); }
  .shot figcaption { font-size: .78rem; color: var(--color-muted); margin-top: .4rem; }
  .cta { margin: 1.6rem 0 .4rem; }
</style>
