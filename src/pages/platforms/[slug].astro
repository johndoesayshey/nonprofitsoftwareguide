---
import { getCollection, render } from 'astro:content';
import ReaderOffer from '../../components/ReaderOffer.astro';
import { relFor } from '../../lib/affiliate-value';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import { CATEGORIES } from '../../lib/categories';
import { getAffiliate } from '../../lib/affiliates';
import { comparePairs } from '../../lib/compare';
import { valueOf } from '../../lib/affiliate-value';

export async function getStaticPaths() {
  const platforms = await getCollection('platforms');
  return platforms.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

// Names for the "other options" links, so a slug change surfaces as a build error
// rather than a wrong label.
const allPlatforms = await getCollection('platforms');
const platformName = new Map(allPlatforms.map((x) => [x.data.slug, x.data.name]));

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const cat = CATEGORIES[p.category];
const affiliate = p.affiliateSlug ? getAffiliate(p.affiliateSlug) : undefined;
const isDraft = p.draft !== false;

// Cluster links. Every comparison and switching guide that names this product,
// linked from the product page itself. Without this the 25 comparison pages and
// 13 alternatives pages each carry a single inbound link from an index — which
// is the same as being orphaned as far as internal PageRank is concerned.
// Ordered by the other product's affiliate value, same rule as everywhere else.
const pairs = (await comparePairs()).filter(
  (x) =>
    (x.a.data.slug === p.slug || x.b.data.slug === p.slug) &&
    x.a.data.draft === false &&
    x.b.data.draft === false
);
const comparisons = pairs
  .map((x) => {
    const other = x.a.data.slug === p.slug ? x.b.data : x.a.data;
    return { slug: x.slug, other, v: valueOf(other.affiliateSlug) };
  })
  .sort((x, y) => y.v - x.v || x.other.name.localeCompare(y.other.name));

const allAlternatives = await getCollection('alternatives');
// The switching guide for leaving THIS product...
const leaving = allAlternatives.find(
  (x) => x.data.draft === false && x.data.incumbentSlug === p.slug
);
// ...and the guides that recommend it, which is where the buying intent is.
const recommendedIn = allAlternatives
  .filter(
    (x) =>
      x.data.draft === false &&
      x.data.incumbentSlug !== p.slug &&
      x.data.picks.some((pick) => pick.platformSlug === p.slug)
  )
  .sort((x, y) => x.data.product.localeCompare(y.data.product));

// Screenshot slot: drop a product screenshot at public/images/platforms/<slug>.png
// (or .webp / .jpg) and it renders automatically with SEO-friendly alt text.
const pubDir = fileURLToPath(new URL('../../../public', import.meta.url));
const shot = ['png', 'webp', 'jpg'].map((ext) => `/images/platforms/${p.slug}.${ext}`)
  .find((rel) => existsSync(pubDir + rel));

// Product JSON-LD. Only attach clean data — never placeholder strings.
const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  category: cat?.label ?? p.category,
  description: p.bestFor,
  brand: { '@type': 'Brand', name: p.name },
  ...(shot ? { image: new URL(shot, Astro.site ?? Astro.url).href } : {}),
};
---

<BaseLayout
  title={`${p.name} review & pricing`}
  description={`${p.name} for nonprofits: pricing, who it fits, and how it compares. ${p.bestFor}.`}
  ogType="product"
  section={p.category}
  noindex={isDraft}>
  <div class="wrap">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: cat?.label ?? p.category, href: cat?.path },
      { label: p.name },
    ]} />

    {isDraft && <DraftBanner />}

    <article class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">{cat?.label ?? p.category}</p>
      <h1>{p.name}</h1>

      <AffiliateDisclosure />

      <div class="pricebox">
        <div>
          <span class="pricebox-label">Starting price</span>
          <span class="pricebox-value">{p.entryPrice}</span>
        </div>
        <div>
          <span class="pricebox-label">Pricing model</span>
          <span class="pricebox-value">{p.pricingModel}</span>
        </div>
        <div>
          <span class="pricebox-label">Free tier</span>
          <span class="pricebox-value">{p.freeTier ? 'Yes' : 'No'}</span>
        </div>
        {affiliate && p.affiliateSlug && (
          <div class="pricebox-cta">
            <a class="btn-primary" href={`/go/${p.affiliateSlug}`} rel={relFor(p.affiliateSlug)}>
              Visit {p.name} →
            </a>
            <ReaderOffer slug={p.affiliateSlug} />
          </div>
        )}
      </div>

      {shot && (
        <figure class="shot">
          <img src={shot} alt={`${p.name} dashboard screenshot showing the main ${cat?.label.toLowerCase() ?? ''} workspace`} loading="lazy" decoding="async" />
          <figcaption>Inside {p.name}.</figcaption>
        </figure>
      )}

      <Content />

      <h2>Strengths</h2>
      <ul>{p.strengths.map((s) => <li>{s}</li>)}</ul>

      <h2>Other options</h2>
      <ul class="alts">
        {p.otherOptions.map((o) => (
          <li>
            <strong>{o.need}</strong> {o.note}
            {o.platformSlug && (
              <> <a href={`/platforms/${o.platformSlug}/`}>Read our {platformName.get(o.platformSlug) ?? o.platformSlug} write-up →</a></>
            )}
          </li>
        ))}
      </ul>

      {(comparisons.length > 0 || leaving || recommendedIn.length > 0) && (
        <section class="cluster">
          <h2>Keep comparing</h2>

          {comparisons.length > 0 && (
            <>
              <p class="cluster-label">{p.name} head to head</p>
              <ul class="chips">
                {comparisons.map((c) => (
                  <li><a href={`/compare/${c.slug}/`}>vs {c.other.name}</a></li>
                ))}
              </ul>
            </>
          )}

          {leaving && (
            <p class="cluster-line">
              Already on {p.name} and shopping to replace it?
              <a href={`/alternatives/${leaving.data.slug}/`}>{p.name} alternatives</a> covers
              why shops leave, what to move to, and when staying put is the right call.
            </p>
          )}

          {recommendedIn.length > 0 && (
            <p class="cluster-line">
              {/* Built as one flat array so no JSX whitespace lands before a
                  comma — "Bloomerang , Donorbox" is the failure mode here. */}
              <Fragment set:html={
                `We recommend ${p.name} to shops leaving ` +
                recommendedIn
                  .map((x) => `<a href="/alternatives/${x.data.slug}/">${x.data.product}</a>`)
                  .reduce((acc, link, i, arr) =>
                    i === 0 ? link : acc + (i === arr.length - 1 ? ' and ' : ', ') + link, '') +
                '.'
              } />
            </p>
          )}
        </section>
      )}

      {affiliate && p.affiliateSlug && (
        <p class="cta">
          <a class="btn-primary" href={`/go/${p.affiliateSlug}`} rel={relFor(p.affiliateSlug)}>
            See {p.name} pricing & book a demo →
          </a>
        </p>
      )}
    </article>
  </div>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productLd)} is:inline />
</BaseLayout>

<style>
  .cluster { margin: 2.4rem 0 1.4rem; padding-top: 1.2rem;
    border-top: 2px solid var(--color-ink); }
  .cluster h2 { margin-top: 0; }
  .cluster-label { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-muted); font-weight: 700;
    margin: .8rem 0 .4rem; }
  .cluster-line { color: var(--color-muted); font-size: .95rem; }
  .chips { list-style: none; padding: 0; margin: 0 0 1rem; display: flex;
    flex-wrap: wrap; gap: .4rem .5rem; }
  .chips li { margin: 0; }
  .chips a { display: inline-block; border: 1px solid var(--color-rule-strong);
    border-radius: 999px; padding: .22rem .7rem; font-size: .84rem;
    text-decoration: none; color: var(--color-ink); }
  .chips a:hover { border-color: var(--color-green); color: var(--color-green-deep); }

  .pricebox-sub { display: block; font-size: .74rem; line-height: 1.35; color: var(--color-muted);
    margin-top: .2rem; }
  .email-included { color: var(--color-green-deep); }
  .email-unknown { font-style: italic; color: var(--color-muted); }

  .alts li { margin-bottom: .6rem; }
  .alts strong { color: var(--color-ink); }

  .pricebox { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .9rem 1.4rem;
    border: 1px solid var(--color-rule-strong); border-left: 3px solid var(--color-green);
    background: var(--color-paper-2); padding: 1.1rem 1.2rem; margin: 1.4rem 0; border-radius: 2px;
    align-items: center; }
  .pricebox-label { display: block; font-size: .68rem; letter-spacing: .1em; font-weight: 700;
    text-transform: uppercase; color: var(--color-muted); }
  .pricebox-value { display: block; font-size: 1.02rem; margin-top: .15rem; }
  .pricebox-cta { display: flex; flex-direction: column; gap: .3rem; align-items: flex-start; }
  .btn-primary { display: inline-block; background: var(--color-green-deep); color: #fff !important;
    font-weight: 700; text-decoration: none; padding: .55rem .95rem; border-radius: 3px; font-size: .95rem; }
  .btn-primary:hover { background: var(--color-green); }
  .offer { font-size: .78rem; font-weight: 700; color: var(--color-green-deep); }
  .shot { margin: 1.4rem 0; }
  .shot img { max-width: 100%; height: auto; border: 1px solid var(--color-rule); border-radius: 4px;
    box-shadow: 0 10px 24px -18px rgba(0,0,0,.4); }
  .shot figcaption { font-size: .78rem; color: var(--color-muted); margin-top: .4rem; }
  .cta { margin: 1.6rem 0 .4rem; }
</style>
