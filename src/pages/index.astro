---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { STACK_TIERS } from '../lib/stacks';
import { formatMonthYear } from '../lib/dates';
import AwardCard from '../components/AwardCard.astro';

// Enrich each tier with its published stack's verified total cost, when one
// exists. Draft/unbuilt stacks show the revenue band instead — we never print an
// unverified dollar figure on a published page.
const stacks = await getCollection('stacks', ({ data }) => data.draft === false);
const bySlug = new Map(stacks.map((s) => [s.data.slug, s.data]));

const rows = STACK_TIERS.map((t, i) => {
  const stack = bySlug.get(t.slug);
  return {
    ...t,
    idx: String(i + 1).padStart(2, '0'),
    total: stack?.totalStackCost ?? null,
    verified: stack?.lastVerified ?? null,
  };
});

const dateFmt = formatMonthYear;

const site = Astro.site ?? new URL('https://nonprofitsoftwareguide.com');
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Nonprofit Software Guide',
  url: site.href,
  description:
    'Independent guide to the nonprofit fundraising software stack, organized by shop size.',
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nonprofit Software Guide',
  url: site.href,
};
---

<BaseLayout title="Nonprofit Software Guide">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} is:inline />
  </Fragment>

  <div class="wrap">
    <section class="hero">
      <div class="hero-top">
        <div class="hero-head">
          <p class="kicker">fundraising stack RECOMMENDATIONS</p>
          <h1>What software you need by the size of your operation.</h1>
        </div>
        <AwardCard />
      </div>
      <div class="cols">
        <p>
          A software "stack" is all the software you use to run your fundraising
          operation. Most non-profits have a way to
          <a href="/donor-crm/">track donor information (CRM)</a>,
          <a href="/grant-research/">find grants</a>,
          <a href="/donation-processing/">process donations</a>,
          <a href="/events/">plan events</a>,
          <a href="/wealth-screening/">find new donors</a>,
          <a href="/forms-operations/">organize projects</a>, and to
          <a href="/forms-operations/">collect information</a>. This guide helps
          you understand the best software based on the size of your fundraising
          operation.
        </p>
        <p>
          Built by a frontline fundraiser with over 15 years experience alongside hundreds of hours of information interviews with 20+ frontline fundraisers across the USA. We make real recommendations you can confidently take to your board and other decision makers.
        </p>
      </div>
    </section>
  </div>

  <!-- Signature element: the "by the numbers" band. -->
  <div class="stat-band"><div class="wrap stat-band-inner">
    <div class="stat"><div class="big num">6</div><div class="lbl">most common software categories reviewed by real fundraisers</div></div>
    <div class="stat"><div class="big num">4</div><div class="lbl">shop sizes, each with its own recommended stack</div></div>
    <div class="stat"><div class="big num">$0</div><div class="lbl">average cost of non-profit fundraising stacks across 50+ surveys</div></div>
    <div class="stat"><div class="big num">15+</div><div class="lbl">years the author has spent in fundraising</div></div>
  </div></div>

  <div class="wrap">
    <section aria-label="Recommended stacks by shop size">
      <h2 class="section-h">Recommended stacks</h2>
      <div class="ledger">
        {rows.map((r) => (
          <a class="ledger-row" href={`/stacks/${r.slug}/`}>
            <span class="idx num">{r.idx}</span>
            <span class="tier">
              {r.tier}
              <small>{r.revenue} raised / yr · {r.blurb}</small>
            </span>
            <span class="amt num">
              {r.total ? r.total : 'costed inside'}
              <small>{r.total && r.verified ? `verified ${dateFmt(r.verified)}` : 'total stack / yr'}</small>
            </span>
            <span class="go">Open the {r.tier.toLowerCase()} stack →</span>
          </a>
        ))}
        <div class="ledger-total">
          <span>Every figure carries a “last verified” date and a source. See the <a href="/benchmarks/">annual spending benchmark</a>.</span>
          <span class="amt num">4 stacks</span>
        </div>
      </div>
    </section>

    <section class="prose" style="margin: 2.6rem 0 1rem;">
      <h2>Why organize by shop size?</h2>
      <p>
        The stack that fits a $400k shop and the stack that fits a $6M shop share
        almost no line items. A grassroots shop can run a completely credible
        operation for close to nothing; a $5M shop that skips prospect research is
        leaving major gifts on the table. Product-by-product “best CRM” lists
        can't tell you which of those you are. Your revenue can.
      </p>
      <h2>What's in a stack</h2>
      <p>
        Six categories, in rough order of return on the dollar for most shops:
        <a href="/grant-research/">grant research</a>,
        <a href="/wealth-screening/">prospect and wealth screening</a>,
        <a href="/donation-processing/">donation processing</a>,
        <a href="/donor-crm/">donor CRM</a>,
        <a href="/forms-operations/">forms and operations</a>, and
        <a href="/events/">events</a>. The pages under each stack walk the line
        items one at a time: what it costs, why it's on the list, and when you've
        outgrown it.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero { padding: clamp(2.2rem, 6vw, 4.4rem) 0 clamp(1.2rem, 3vw, 2rem); }
  .hero h1 { max-width: 17ch; }
  /* Headline left, award spotlight in what used to be dead space on the right. */
  .hero-top { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; gap: 2.6rem;
    align-items: start; margin-bottom: clamp(1.4rem, 3vw, 2.2rem); }
  @media (max-width: 900px) { .hero-top { grid-template-columns: 1fr; gap: 1.6rem; } }
  .cols { columns: 2; column-gap: 2.4rem; color: var(--color-muted); max-width: 54rem; }
  .cols p { margin: 0 0 1rem; break-inside: avoid; }
  @media (max-width: 640px) { .cols { columns: 1; } }
  .section-h { font-size: .95rem; text-transform: uppercase; letter-spacing: .14em;
    color: var(--color-muted); font-weight: 700; margin: 2.4rem 0 .4rem; }
</style>
