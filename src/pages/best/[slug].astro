---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import ReaderOffer from '../../components/ReaderOffer.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import { CATEGORIES } from '../../lib/categories';
import { relFor, valueOf } from '../../lib/affiliate-value';
import { formatMedium } from '../../lib/dates';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const g = entry.data;
const { Content } = await render(entry);
const isDraft = g.draft !== false;

const allPlatforms = await getCollection('platforms');
const bySlug = new Map(allPlatforms.map((p) => [p.data.slug, p.data]));
// A roundup is a recommendation, so it only carries featured products. Dropping
// a pick here is silent by design: unfeaturing a product should quietly remove
// it from every list rather than leaving a hole someone has to notice.
const cat = CATEGORIES[g.category];

// Same ordering rule as the rest of the site — affiliate value first, authored
// order breaking ties. The `award` on each pick is what carries the editorial
// distinction, so the list stays honest without being hand-sorted.
const picks = g.picks
  .filter((p) => bySlug.get(p.platformSlug)?.featured)
  .map((p, i) => ({ p, i, v: valueOf(bySlug.get(p.platformSlug)!.affiliateSlug) }))
  .sort((x, y) => y.v - x.v || x.i - y.i)
  .map((x) => x.p);

const site = Astro.site ?? new URL('https://nonprofitsoftwareguide.com');
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: g.title,
  itemListElement: picks.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: bySlug.get(p.platformSlug)!.name,
    url: new URL(`/platforms/${p.platformSlug}/`, site).href,
  })),
};
const faqLd = g.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: g.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<BaseLayout
  title={g.title}
  description={g.answer.slice(0, 155)}
  section={cat?.slug ?? 'compare'}
  noindex={isDraft}>
  <div class="wrap">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      ...(cat?.path ? [{ label: cat.label, href: cat.path }] : []),
      { label: g.audience ? `For ${g.audience}` : "Editor's picks" },
    ]} />

    {isDraft && <DraftBanner />}

    <article class="prose guide" style="margin-top: 1.2rem; max-width: none;">
      <p class="kicker">{g.audience ? `${cat?.label ?? ''} · ${g.audience}` : cat?.label}</p>
      <h1>{g.title}</h1>

      <!-- Answer first, 40-60 words. This is what gets lifted into a snippet. -->
      <p class="answer">{g.answer}</p>

      <p class="verified-row"><span class="verified">Prices checked {formatMedium(g.lastVerified)}</span></p>

      <AffiliateDisclosure />

      <div class="table-scroll">
        <table class="picks">
          <colgroup>
            <col class="c-award" /><col class="c-tool" /><col class="c-price" />
            <col class="c-for" /><col class="c-cta" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Award</th>
              <th scope="col">Tool</th>
              <th scope="col">Pricing</th>
              <th scope="col">Right for</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            {picks.map((p) => {
              const plat = bySlug.get(p.platformSlug)!;
              return (
                <tr>
                  <td class="award-cell">{p.award}</td>
                  <th scope="row"><a href={`/platforms/${p.platformSlug}/`}>{plat.name}</a></th>
                  <td class="price">
                    {plat.pricingTiers.length > 0 ? (
                      <ul class="ladder">
                        {plat.pricingTiers.slice(0, 4).map((t) => (
                          <li><span class="t-name">{t.tier}</span><span class="t-price">{t.price}</span></li>
                        ))}
                      </ul>
                    ) : (
                      <span class="num">{plat.entryPrice}</span>
                    )}
                  </td>
                  <td class="for">{p.forWhom}</td>
                  <td class="cta">
                    <a class="btn-visit" href={`/go/${p.platformSlug}`} rel={relFor(p.platformSlug)}>Visit →</a>
                    <ReaderOffer slug={plat.affiliateSlug} compact />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {picks.map((p) => {
        const plat = bySlug.get(p.platformSlug)!;
        return (
          <section class="pick-detail">
            <h2>{plat.name} <span class="pick-award">— {p.award}</span></h2>
            <p class="pick-for"><strong>Right for:</strong> {p.forWhom}</p>
            <p>{p.note}</p>
            <p class="pick-links">
              <a href={`/platforms/${p.platformSlug}/`}>Full {plat.name} write-up →</a>
            </p>
          </section>
        );
      })}

      <h2>What actually decides this</h2>
      <ul class="factors">
        {g.decidingFactors.map((f) => (
          <li><strong>{f.factor}</strong> {f.detail}</li>
        ))}
      </ul>

      <!-- Body carries the judgment specific to this audience. -->
      <Content />

      {g.faq && g.faq.length > 0 && (
        <section class="faq">
          <h2>Common questions</h2>
          {g.faq.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}

      <p class="foot-links">
        See every option in <a href={cat?.path ?? '/compare/'}>{(cat?.label ?? 'this category').toLowerCase()}</a>,
        or start from <a href="/">the recommended stack for your size</a>.
      </p>
    </article>
  </div>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd)} is:inline />
  {faqLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} is:inline />}
</BaseLayout>

<style>
  .guide > p, .guide > h1, .guide > h2, .guide > ul, .guide > section { max-width: 46rem; }
  .answer { font-size: 1.12rem; line-height: 1.55; border-left: 4px solid var(--color-green-deep);
    padding-left: 1rem; margin: 1rem 0 1.1rem; }
  .verified-row { margin: 0 0 1.2rem; }

  .table-scroll { overflow-x: auto; margin: 1rem 0 2.2rem; max-width: 62rem; }
  table.picks { width: 100%; min-width: 48rem; border-collapse: collapse; font-size: .92rem;
    table-layout: fixed; }
  table.picks col.c-award { width: 14%; } table.picks col.c-tool { width: 15%; }
  table.picks col.c-price { width: 24%; } table.picks col.c-for { width: 26%; }
  table.picks col.c-cta { width: 21%; }
  table.picks th, table.picks td { text-align: left; padding: .6rem .7rem;
    border-bottom: 1px solid var(--color-rule); vertical-align: top; }
  table.picks thead th { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase;
    font-weight: 800; color: var(--color-muted); border-bottom: 2px solid var(--color-ink); }
  table.picks tbody th a { font-weight: 800; text-decoration: none; color: var(--color-ink); }
  table.picks tbody th a:hover { color: var(--color-green-deep); text-decoration: underline; }
  .award-cell { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em;
    text-transform: uppercase; font-weight: 700; color: var(--color-green-deep); }
  .for { color: var(--color-muted); }

  .ladder { list-style: none; margin: 0; padding: 0; font-size: .84rem; line-height: 1.3; }
  .ladder li { display: grid; grid-template-columns: 1fr auto; column-gap: .5rem;
    padding: .12rem 0; border-bottom: 1px dotted var(--color-rule); }
  .ladder li:last-child { border-bottom: 0; }
  .t-name { color: var(--color-muted); min-width: 0; }
  .t-price { font-weight: 700; color: var(--color-green-deep); white-space: nowrap; }

  .btn-visit { display: inline-block; background: var(--color-green-deep); color: #fff;
    font-weight: 700; text-decoration: none; padding: .35rem .7rem; border-radius: 3px;
    font-size: .82rem; }
  .btn-visit:hover { background: var(--color-green); }

  .pick-detail { margin: 1.8rem 0; }
  .pick-detail h2 { margin-bottom: .25rem; }
  .pick-award { font-weight: 400; color: var(--color-muted); font-size: .78em; }
  .pick-for { margin: .2rem 0 .5rem; color: var(--color-muted); font-size: .95rem; }
  .pick-links { margin: .4rem 0 0; font-size: .9rem; }

  .factors { list-style: none; padding: 0; }
  .factors li { padding: .7rem 0 .7rem 1.5rem; border-bottom: 1px solid var(--color-rule);
    position: relative; }
  .factors li:last-child { border-bottom: 0; }
  .factors li::before { content: '·'; position: absolute; left: .3rem; font-weight: 800;
    color: var(--color-green-deep); font-size: 1.4em; line-height: 1; }
  .factors strong { color: var(--color-ink); }

  .faq { margin-top: 2.4rem; padding-top: 1.2rem; border-top: 2px solid var(--color-ink); }
  .faq-item h3 { font-size: 1rem; margin-bottom: .2rem; }
  .faq-item p { margin-top: 0; color: var(--color-muted); }

  .foot-links { color: var(--color-muted); font-size: .93rem; margin-top: 2rem; }
</style>
