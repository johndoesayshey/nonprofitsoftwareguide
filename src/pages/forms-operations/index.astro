---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryHub from '../../components/CategoryHub.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
---
<BaseLayout
  title="Forms & operations software for nonprofits"
  description="Jotform, Airtable, and monday.com for nonprofit operations: intake forms, registrations, and the lists that hold a shop together, with real pricing."
  section="forms-ops">
  <div class="wrap">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Forms & operations' }]} />
    <section class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">Category guide</p>
      <h1>Forms &amp; other operations</h1>
      <p class="lede">
        The operational layer: program applications, volunteer intake, event
        registrations, and the lists and projects that hold a shop together.
        It's the cheapest category in the stack, and often the first one a
        grassroots shop actually pays for.
      </p>

      <h2>How to choose</h2>
      <p>
        Buy a real form builder the day a program application outgrows email.
        <a href="/go/jotform" rel="sponsored nofollow noopener">Jotform</a> is
        the default: a capable free tier, paid plans from about $34/mo, and a
        permanent 50% nonprofit discount that brings Bronze to roughly $17/mo.
        For the work behind the forms, pick by shape:
        <a href="/go/airtable" rel="sponsored nofollow noopener">Airtable</a>
        for data-shaped work (rosters, inventories, trackers) and
        <a href="/go/monday" rel="sponsored nofollow noopener">monday.com</a>
        for project-shaped work (owners, due dates, program plans). Both start
        free, and monday.com runs a nonprofit program with discounted plans.
      </p>
      <p>
        One discipline keeps this category from becoming a liability: anything
        you learn about a donor belongs in the
        <a href="/donor-crm/">donor CRM</a>, and donations belong on a
        <a href="/donation-processing/">giving platform</a>. Forms and boards
        are for operations.
      </p>
    </section>

    <CategoryHub category="forms-ops" />

    <div class="prose">
      <p>
        Ops tooling appears in every tier, starting free in
        <a href="/stacks/under-250k/">the grassroots stack</a>.
      </p>
      <AffiliateDisclosure />
    </div>
  </div>
</BaseLayout>
