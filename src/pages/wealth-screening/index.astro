---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryHub from '../../components/CategoryHub.astro';
import { CATEGORIES } from '../../lib/categories';
const meta = CATEGORIES['prospect-research'];
---
<BaseLayout title="Wealth screening & prospect research software" description={meta.blurb} section="wealth">
  <div class="wrap">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Wealth screening' }]} />
    <section class="prose" style="margin-top: 1.2rem;">
      <p class="kicker">Category</p>
      <h1>Wealth screening &amp; prospect research</h1>
      <p class="lede">{meta.blurb}</p>
    </section>
    <CategoryHub category="prospect-research" />
  </div>
</BaseLayout>
