---
// The survey instrument, published on the same page as the results.
//
// Showing the questions is the point. A reader who can see exactly what was
// asked, and can answer it themselves, has a reason to believe the numbers.
//
// No backend: the site is static by design. Delivery is set in
// src/data/survey-form.json:
//   provider "jotform"     — embeds a hosted form; responses are actually stored
//   provider "placeholder" — validates and confirms, but STORES NOTHING
//
// The placeholder exists so the instrument can be published and reviewed before
// the backend is written. It tells the reader their response was recorded when
// it was not, so it should not stay in front of real traffic for long.
import survey from '../data/survey-2026.json';
import form from '../data/survey-form.json';

const s = survey as any;
const f = form as any;
const useEmbed = f.provider === 'jotform' && f.formUrl;
---

<section class="contribute" id="contribute">
  <p class="kicker">The instrument</p>
  <h2>Contribute your numbers to the 2027 edition</h2>

  <p class="intro">
    These are the questions asked in {s.fielded}, reproduced exactly. If you work
    in fundraising in the United States, answering takes about two minutes and
    your figures join the next edition. {f.closesNote}
  </p>

  {useEmbed ? (
    <div class="embed-wrap">
      <iframe
        src={f.formUrl}
        title="Fundraising software spend survey"
        loading="lazy"
        allow="geolocation; microphone; camera; fullscreen"></iframe>
    </div>
  ) : (
    <form id="spend-survey" novalidate>
      <fieldset>
        <legend>1. Your organization</legend>

        <label for="sv-size">How much does your organization raise annually?</label>
        <select id="sv-size" name="size" required>
          <option value="">Select one…</option>
          {s.segments.map((seg: any) => <option value={seg.label}>{seg.label}</option>)}
        </select>
      </fieldset>

      <fieldset>
        <legend>2. Annual software spend, by category</legend>
        <p class="hint">
          Whole US dollars per year. Estimates are fine, and anything you leave
          blank is recorded as <strong>$0</strong>, spending nothing in a
          category is a real answer and counts the same as any other.
        </p>

        <div class="grid">
          {s.categories.map((c: any) => (
            <div class="field">
              <label for={`sv-${c.slug}`}>{c.label}</label>
              <div class="money">
                <span class="prefix" aria-hidden="true">$</span>
                <input
                  type="number" id={`sv-${c.slug}`} name={c.slug}
                  min="0" step="1" inputmode="numeric" placeholder="0"
                  data-label={c.label} />
                <span class="suffix">/yr</span>
              </div>
            </div>
          ))}
        </div>

        <p class="running" aria-live="polite">Total entered: <strong id="sv-total">$0</strong></p>
      </fieldset>

      <fieldset>
        <legend>3. Verification</legend>
        <p class="hint">
          So we can confirm responses come from real fundraising professionals.
          <strong>Complete either option.</strong>
        </p>

        <div class="verify-opt">
          <p class="opt-head">Option A: your role</p>
          <div class="grid">
            <div class="field">
              <label for="sv-title">Job title</label>
              <input type="text" id="sv-title" name="title" autocomplete="off" />
            </div>
            <div class="field">
              <label for="sv-org">Organization name</label>
              <input type="text" id="sv-org" name="org" autocomplete="off" />
            </div>
          </div>
        </div>

        <p class="or-rule"><span>or</span></p>

        <div class="verify-opt">
          <p class="opt-head">Option B: your LinkedIn</p>
          <div class="field">
            <label for="sv-li">LinkedIn profile</label>
            <input type="text" id="sv-li" name="linkedin" autocomplete="off" inputmode="url" />
          </div>
        </div>

        <p class="privacy">{f.privacyNote}</p>
      </fieldset>

      <p class="actions">
        <button type="submit" class="btn-submit">Submit your response</button>
        <span class="status" id="sv-status" role="status"></span>
      </p>
    </form>
  )}

  {!useEmbed && (
    <div id="sv-dialog" class="sv-overlay" hidden>
      <div class="sv-modal" role="dialog" aria-modal="true" aria-labelledby="sv-dialog-title">
        <p class="sv-check" aria-hidden="true">✓</p>
        <h3 id="sv-dialog-title">{f.confirmTitle}</h3>
        <p>{f.confirmBody}</p>
        <button type="button" class="btn-submit" id="sv-dialog-close">Close</button>
      </div>
    </div>
  )}
</section>

{!useEmbed && (
  <script is:inline>
    (function () {
      var form = document.getElementById('spend-survey');
      if (!form) return;
      var statusEl = document.getElementById('sv-status');
      var totalEl = document.getElementById('sv-total');
      var money = function (n) { return '$' + (n || 0).toLocaleString('en-US'); };

      function amounts() {
        return Array.prototype.slice.call(form.querySelectorAll('input[type="number"]'));
      }

      function retotal() {
        var sum = 0;
        amounts().forEach(function (i) {
          var v = parseFloat(i.value);
          if (!isNaN(v) && v >= 0) sum += v;
        });
        totalEl.textContent = money(sum);
        return sum;
      }
      form.addEventListener('input', retotal);
      retotal();

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        statusEl.className = 'status';

        var size = form.querySelector('#sv-size').value;
        var title = form.querySelector('#sv-title').value.trim();
        var org = form.querySelector('#sv-org').value.trim();
        var linkedin = form.querySelector('#sv-li').value.trim();

        // Two ways to verify: role (title AND organization) or a LinkedIn
        // profile. Either one complete is enough. Spend fields are optional;
        // a blank is a real answer and is recorded as zero.
        var hasRole = title && org;
        var missing = [];
        if (!size) missing.push('how much your organization raises');
        if (!hasRole && !linkedin) {
          missing.push(title || org
            ? 'both job title and organization, or a LinkedIn profile instead'
            : 'either job title and organization, or a LinkedIn profile');
        }

        if (missing.length) {
          statusEl.className = 'status error';
          statusEl.textContent = 'Still needed: ' + missing.join('; ') + '.';
          (!size ? form.querySelector('#sv-size')
                 : (!title ? form.querySelector('#sv-title') : form.querySelector('#sv-org'))).focus();
          return;
        }

        // Placeholder: nothing is transmitted or stored. Swap provider to
        // "jotform" in src/data/survey-form.json to start capturing responses.
        statusEl.textContent = '';
        openDialog();
        form.reset();
        retotal();
      });

      // ---------- confirmation dialog ----------
      var dialog = document.getElementById('sv-dialog');
      var closeBtn = document.getElementById('sv-dialog-close');
      var lastFocus = null;

      function openDialog() {
        lastFocus = document.activeElement;
        dialog.hidden = false;
        closeBtn.focus();
        document.addEventListener('keydown', onKey);
      }
      function closeDialog() {
        dialog.hidden = true;
        document.removeEventListener('keydown', onKey);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function onKey(e) { if (e.key === 'Escape') closeDialog(); }

      closeBtn.addEventListener('click', closeDialog);
      dialog.addEventListener('click', function (e) { if (e.target === dialog) closeDialog(); });

    })();
  </script>
)}

<style>
  .contribute { border-top: 2px solid var(--color-ink); margin-top: 3rem; padding-top: 1.6rem;
    max-width: 46rem; }
  .contribute h2 { margin-top: .2rem; }
  .intro { color: var(--color-muted); }

  .embed-wrap { border: 1px solid var(--color-rule-strong); border-radius: 4px; overflow: hidden; }
  .embed-wrap iframe { width: 100%; min-height: 900px; border: 0; display: block; }

  fieldset { border: 0; padding: 0; margin: 0 0 1.8rem; }
  legend { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--color-green-deep); font-weight: 700;
    padding: 0; margin-bottom: .7rem; }
  .hint { font-size: .88rem; color: var(--color-muted); margin: 0 0 .9rem; }

  label { display: block; font-weight: 600; font-size: .92rem; margin-bottom: .3rem; }
  .or { font-weight: 400; color: var(--color-muted); font-style: italic; }

  input[type="text"], input[type="number"], select {
    width: 100%; font: inherit; font-size: .95rem; padding: .5rem .6rem;
    border: 1px solid var(--color-rule-strong); border-radius: 3px;
    background: var(--color-paper); color: var(--color-ink); }
  input:focus-visible, select:focus-visible { outline: 3px solid var(--color-green);
    outline-offset: 1px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: .9rem 1.2rem; }
  .field { min-width: 0; margin-bottom: .2rem; }

  .money { display: flex; align-items: stretch; }
  .money .prefix, .money .suffix { display: flex; align-items: center; padding: 0 .5rem;
    background: var(--color-paper-2); border: 1px solid var(--color-rule-strong);
    color: var(--color-muted); font-size: .88rem; }
  .money .prefix { border-right: 0; border-radius: 3px 0 0 3px; }
  .money .suffix { border-left: 0; border-radius: 0 3px 3px 0; white-space: nowrap; }
  .money input { border-radius: 0; text-align: right; }

  .running { margin: 1rem 0 0; font-family: var(--font-mono); font-size: .8rem;
    text-transform: uppercase; letter-spacing: .06em; color: var(--color-muted); }
  .running strong { color: var(--color-green-deep); font-size: 1rem; }

  .verify-opt { border: 1px solid var(--color-rule); border-radius: 3px;
    padding: .9rem 1rem .5rem; background: var(--color-paper-2); }
  .opt-head { margin: 0 0 .6rem; font-size: .78rem; font-weight: 800; letter-spacing: .06em;
    text-transform: uppercase; color: var(--color-green-deep); }
  .or-rule { display: flex; align-items: center; gap: .8rem; margin: .9rem 0;
    color: var(--color-muted); font-size: .8rem; text-transform: uppercase;
    letter-spacing: .1em; font-weight: 700; }
  .or-rule::before, .or-rule::after { content: ''; flex: 1; height: 1px; background: var(--color-rule); }

  .privacy { font-size: .82rem; color: var(--color-muted); margin: .9rem 0 0;
    padding-left: .8rem; border-left: 2px solid var(--color-rule); }

  .actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; margin: 0; }
  .btn-submit { font: inherit; font-weight: 700; font-size: .95rem; cursor: pointer;
    background: var(--color-green-deep); color: #fff; border: 0; border-radius: 3px;
    padding: .65rem 1.3rem; }
  .btn-submit:hover { background: var(--color-green); }
  .status { font-size: .86rem; }

  /* Confirmation dialog. Plain overlay rather than <dialog> so the styling is
     predictable across browsers; focus moves in and returns on close. */
  .sv-overlay { position: fixed; inset: 0; z-index: 9999; display: flex;
    align-items: center; justify-content: center; padding: 1.2rem;
    background: rgba(20, 21, 20, .55); }
  .sv-overlay[hidden] { display: none; }
  .sv-modal { background: var(--color-paper); border: 2px solid var(--color-ink);
    border-radius: 4px; padding: 1.6rem 1.8rem; max-width: 26rem; text-align: center;
    box-shadow: 0 18px 50px rgba(0,0,0,.3); }
  .sv-check { width: 2.4rem; height: 2.4rem; margin: 0 auto .8rem; border-radius: 50%;
    background: var(--color-green-deep); color: #fff; font-size: 1.3rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; }
  .sv-modal h3 { margin: 0 0 .5rem; font-size: 1.15rem; }
  .sv-modal p { margin: 0 0 1.2rem; color: var(--color-muted); font-size: .93rem; }
  @media (prefers-reduced-motion: no-preference) {
    .sv-modal { animation: sv-pop .16s ease-out; }
    @keyframes sv-pop { from { transform: scale(.96); opacity: 0; } }
  }
  .status.error { color: var(--color-red); font-weight: 600; }
  .status.ok { color: var(--color-green-deep); font-weight: 600; }
</style>
