---
// Some line items are better bought as a project than a subscription. Wealth
// screening is the clearest case: below a certain size, a one-off screening
// engagement costs less than a year of platform access and comes with someone
// who reads the results. This card makes that recommendation concrete.
//
// The card links to /consulting/, where the operator takes this work directly.
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Buy this as a project, not a subscription',
  body = '',
} = Astro.props;
---
<aside class="consult">
  <p class="consult-kicker">Recommendation</p>
  <h3>{heading}</h3>
  {body && <p class="consult-body">{body}</p>}
  <slot />
  <p class="consult-status">
    <a class="consult-link" href="/consulting/">Talk to a consultant about this →</a>
  </p>
</aside>

<style>
  .consult { border: 1px solid var(--color-rule-strong); border-left: 4px solid var(--color-green-deep);
    border-radius: 3px; background: var(--color-paper-2); padding: 1.1rem 1.3rem; margin: 1.6rem 0; }
  .consult-kicker { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-green-deep); margin: 0 0 .3rem; font-weight: 700; }
  .consult h3 { margin: 0 0 .5rem; font-size: 1.12rem; }
  .consult :global(p) { margin: 0 0 .7rem; }
  .consult :global(p:last-of-type) { margin-bottom: 0; }
  .consult-status { margin: .9rem 0 0 !important; padding-top: .8rem;
    border-top: 1px solid var(--color-rule); }
  .consult-link { font-weight: 700; font-size: .9rem; text-decoration: none;
    color: var(--color-green-deep); }
  .consult-link:hover { text-decoration: underline; }
</style>
