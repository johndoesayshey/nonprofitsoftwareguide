---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/categories';
import { categoryValue } from '../lib/affiliate-value';

interface Props {
  section?: string;
}
const { section } = Astro.props;

// The six software categories live behind one "Software" menu so the nav stays
// short, ordered by how much the category can actually earn. Categories with no
// working affiliate program sink to the bottom. This reorders itself from
// affiliates.json as programs are approved or die.
const allPlatforms = await getCollection('platforms');
const categories = Object.values(CATEGORIES)
  .filter((c) => c.path)
  .map((c) => ({
    href: c.path!,
    label: c.label,
    key: c.slug,
    value: categoryValue(
      allPlatforms.filter((p) => p.data.category === c.slug).map((p) => p.data.affiliateSlug ?? '')
    ),
  }))
  .sort((a, b) => b.value - a.value);

const softwareActive = categories.some((c) => c.key === section);

// "Stacks" points home: the homepage already is the stack index, so a separate
// /stacks/ page would compete with it for the same search intent.
const before = [{ href: '/', label: 'Stacks', key: 'stacks' }];
const after = [
  { href: '/compare/', label: 'Compare', key: 'compare' },
  { href: '/benchmarks/', label: 'Benchmark', key: 'benchmark' },
  { href: '/blog/', label: 'Blog', key: 'blog' },
];
---
<header class="site-header">
  <div class="wrap masthead">
    <a href="/" class="wordmark">Nonprofit Software <b>Guide</b></a>
    <nav class="site-nav" aria-label="Primary">
      {before.map((n) => (
        <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>
      ))}

      <details class="nav-menu" data-nav-menu>
        <summary aria-current={softwareActive ? 'page' : undefined}>
          Software<span class="caret" aria-hidden="true">▾</span>
        </summary>
        <ul>
          {categories.map((c) => (
            <li>
              <a href={c.href} aria-current={section === c.key ? 'page' : undefined}>{c.label}</a>
            </li>
          ))}
          <li class="nav-menu-all">
            <a href="/platforms/">All platforms</a>
          </li>
        </ul>
      </details>

      {after.map((n) => (
        <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  // Close the menu on outside click or Escape. Without JS the <details> element
  // still opens and closes on click, so the nav degrades gracefully.
  (function () {
    var menus = document.querySelectorAll('[data-nav-menu]');
    document.addEventListener('click', function (e) {
      menus.forEach(function (m) {
        if (!m.contains(e.target)) m.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') menus.forEach(function (m) { m.removeAttribute('open'); });
    });
  })();
</script>
