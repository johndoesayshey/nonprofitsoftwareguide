---
import { getCollection } from 'astro:content';
import { comparePairs } from '../lib/compare';
import ReaderOffer from './ReaderOffer.astro';
import { CATEGORIES } from '../lib/categories';
import { getAffiliate } from '../lib/affiliates';
import { byValue, valueOf, potentialOf, relFor } from '../lib/affiliate-value';

interface Props {
  category: string;              // category slug
  part?: 'table' | 'tools' | 'all';
}
const { category, part = 'all' } = Astro.props;
const meta = CATEGORIES[category];

// Tools are listed highest-earning first. Products with no working affiliate
// program still appear (a guide that hides the free options is not credible)
// but they sink to the bottom rather than leading the page.
// featured: false products are deliberately absent here. Their pages stay live
// and indexable — see the note on the field in content/config.ts — they just do
// not compete for space in a shortlist a reader is meant to act on.
const inCategory = (await getCollection('platforms', ({ data }) => data.draft === false && data.featured))
  .filter((p) => p.data.category === category || (p.data.alsoIn ?? []).includes(category as any))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));


const platforms = byValue(inCategory, (p) => p.data.affiliateSlug);

// Head-to-heads for each product, attached to its own row rather than pooled.
// Reads name-first for the row it sits under, even though the slug is
// alphabetical, and orders by the other product's affiliate value.
const allPairs = (await comparePairs()).filter(
  (x) => x.a.data.draft === false && x.b.data.draft === false
);
const versusFor = (slug: string) =>
  allPairs
    .filter((x) => x.category === category && (x.a.data.slug === slug || x.b.data.slug === slug))
    .map((x) => {
      const other = x.a.data.slug === slug ? x.b.data : x.a.data;
      return { slug: x.slug, other, v: valueOf(other.affiliateSlug) };
    })
    .sort((a, b) => b.v - a.v || a.other.name.localeCompare(b.other.name));

const guides = (await getCollection('guides', ({ data }) => data.draft === false))
  .filter((g) => g.data.category === category)
  .sort((a, b) => (a.data.audience ?? '').localeCompare(b.data.audience ?? ''));

const posts = (await getCollection('posts', ({ data }) => data.draft === false))
  .filter((p) => p.data.platformsMentioned.some((s) => platforms.find((pl) => pl.data.slug === s)))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);
---
{(part === 'table' || part === 'all') && platforms.length > 1 && (
  <div class="prose" style="max-width: none;">
    <h2>Compare at a glance</h2>
    <div class="cmp-scroll">
      <table class="cmp">
        <colgroup>
          <col class="c-tool" /><col class="c-price" /><col class="c-free" />
          <col class="c-best" /><col class="c-cta" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Tool</th>
            <th scope="col">Pricing</th>
            <th scope="col">Free tier</th>
            <th scope="col">Best for</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((p) => {
            const aff = p.data.affiliateSlug ? getAffiliate(p.data.affiliateSlug) : undefined;
            const versus = versusFor(p.data.slug);
            return (
              <>
              <tr class="tool-row">
                <th scope="row">
                  <a href={`/platforms/${p.data.slug}/`}>{p.data.name}</a>
                </th>
                <td class="price">
                  {p.data.pricingTiers.length > 0 ? (
                    <>
                      <ul class="ladder">
                        {p.data.pricingTiers.map((t) => (
                          <li>
                            <span class="t-name">{t.tier}</span>
                            <span class="t-price">{t.price}</span>
                            {t.note && <span class="t-note">{t.note}</span>}
                          </li>
                        ))}
                      </ul>
                      {p.data.pricingBasis && <span class="basis">{p.data.pricingBasis}</span>}
                    </>
                  ) : (
                    <span class="num">{p.data.entryPrice}</span>
                  )}
                </td>
                <td>{p.data.freeTier ? 'Yes' : 'No'}</td>
                <td class="cmp-best">{p.data.bestFor}</td>
                <td class="cmp-cta">
                  <a class="btn-visit" href={`/go/${p.data.affiliateSlug}`} rel={relFor(p.data.affiliateSlug)}>Visit →</a>
                  <ReaderOffer slug={p.data.affiliateSlug} compact />
                </td>
              </tr>
              {versus.length > 0 && (
                <tr class="versus-row">
                  <td colspan="5">
                    <div class="versus-inner">
                      <span class="versus-label">Compare {p.data.shortName ?? p.data.name}:</span>
                      {versus.map((v) => (
                        <a class="versus-link" href={`/compare/${v.slug}/`}>vs {v.other.shortName ?? v.other.name}</a>
                      ))}
                    </div>
                  </td>
                </tr>
              )}
              </>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
)}

{(part === 'tools' || part === 'all') && (
<div class="prose" style="max-width: none;">
  <h2>The tools in detail</h2>
</div>
)}

{(part === 'tools' || part === 'all') && (platforms.length === 0 ? (
  <p class="empty">Coverage for {meta?.label.toLowerCase()} is in the pipeline.</p>
) : (
  <div class="tool-grid">
    {platforms.map((p) => {
      const aff = p.data.affiliateSlug ? getAffiliate(p.data.affiliateSlug) : undefined;
      const earns = potentialOf(p.data.affiliateSlug) !== 'none';
      return (
        <div class="tool-card">
          <div class="tool-head">
            <a class="tool-name" href={`/platforms/${p.data.slug}/`}>{p.data.name}</a>
            {p.data.freeTier && <span class="tag">free tier</span>}
          </div>
          {p.data.pricingTiers.length > 0 ? (
            <ul class="ladder">
              {p.data.pricingTiers.map((t) => (
                <li><span class="t-name">{t.tier}</span><span class="t-price">{t.price}</span></li>
              ))}
            </ul>
          ) : (
            <p class="tool-price num">{p.data.entryPrice}</p>
          )}
          <p class="tool-best">{p.data.bestFor}</p>
          <div class="tool-actions">
            <a class="btn-visit" href={`/go/${p.data.affiliateSlug}`} rel={relFor(p.data.affiliateSlug)}>Visit site →</a>
            <a class="link-review" href={`/platforms/${p.data.slug}/`}>Review</a>
          </div>
          <ReaderOffer slug={p.data.affiliateSlug} as="p" />
        </div>
      );
    })}
  </div>
))}

{(part === 'tools' || part === 'all') && posts.length > 0 && (
  <div class="prose" style="margin-top: 1.6rem;">
    <h2>Related reading</h2>
    <ul>
      {posts.slice(0, 6).map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
    </ul>
  </div>
)}

{(part === 'tools' || part === 'all') && guides.length > 0 && (
  <div class="prose guides-block" style="max-width: none;">
    <h2>Picked for your kind of organization</h2>
    <ul class="guide-list">
      {guides.map((g) => (
        <li><a href={`/best/${g.data.slug}/`}>{g.data.title}</a></li>
      ))}
    </ul>
    <p class="guide-more"><a href="/best/">All best-of guides →</a></p>
  </div>
)}

<style>
  .cmp-scroll { overflow-x: auto; margin: 1rem 0 1.6rem; }
  /* Fixed widths, or the browser hands most of the row to whichever cell has the
     longest unbroken string and squeezes "Best for" into a column of single
     words. The proportions below keep every row two or three lines tall. */
  table.cmp { width: 100%; min-width: 48rem; border-collapse: collapse; font-size: .92rem;
    table-layout: fixed; }
  table.cmp col.c-tool  { width: 15%; }
  table.cmp col.c-price { width: 26%; }
  table.cmp col.c-free  { width: 7%; }
  table.cmp col.c-best  { width: 30%; }
  table.cmp col.c-cta   { width: 22%; }
  table.cmp th, table.cmp td { text-align: left; padding: .6rem .7rem; border-bottom: 1px solid var(--color-rule);
    vertical-align: top; }
  table.cmp thead th { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; font-weight: 800;
    color: var(--color-muted); border-bottom: 2px solid var(--color-ink); }
  table.cmp tbody th a { font-weight: 800; text-decoration: none; color: var(--color-ink); }
  table.cmp tbody th a:hover { color: var(--color-green-deep); text-decoration: underline; }
  table.cmp .num { font-weight: 700; color: var(--color-green-deep); }
  .cmp-best { color: var(--color-muted); }
  /* Full price ladder in the chart. "From $39" tells a buyer nothing about year
     two, so every published tier is listed and the basis is named underneath. */
  .ladder { list-style: none; margin: 0; padding: 0; font-size: .84rem; line-height: 1.3; }
  .ladder li { display: grid; grid-template-columns: 1fr auto; column-gap: .5rem;
    padding: .12rem 0; border-bottom: 1px dotted var(--color-rule); }
  .ladder li:last-child { border-bottom: 0; }
  .t-name { color: var(--color-muted); min-width: 0; }
  .t-price { font-weight: 700; color: var(--color-green-deep); white-space: nowrap;
    font-variant-numeric: tabular-nums; }
  .t-note { grid-column: 1 / -1; font-size: .92em; color: var(--color-muted); opacity: .85; }
  .basis { display: block; margin-top: .35rem; font-size: .72rem; color: var(--color-muted);
    font-style: italic; }
  /* The CTA column holds a button and a short offer line. Cap its width and let
     the offer wrap, or a long offer stretches the column wider than the price
     and drags every row taller. */
  tr.tool-row > * { border-bottom: 0; padding-bottom: .35rem; }
  tr.versus-row td { border-bottom: 1px solid var(--color-rule); padding: 0 .7rem .7rem; }
  .versus-inner { position: sticky; left: .7rem; width: min(100%, calc(100vw - 3.4rem)); }
  .versus-label { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--color-muted); font-weight: 700;
    margin-right: .5rem; white-space: nowrap; }
  .versus-link { display: inline-block; font-size: .8rem; text-decoration: none;
    color: var(--color-green-deep); border-bottom: 1px solid var(--color-rule-strong);
    margin: 0 .7rem .15rem 0; white-space: nowrap; }
  .versus-link:hover { border-bottom-color: var(--color-green); }

  .guides-block { margin-top: 2rem; }
  .guide-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem .6rem;
    margin: .8rem 0; }
  .guide-list li { margin: 0; }
  .guide-list a { display: inline-block; border: 1px solid var(--color-rule-strong);
    border-radius: 999px; padding: .25rem .75rem; font-size: .85rem; text-decoration: none;
    color: var(--color-ink); }
  .guide-list a:hover { border-color: var(--color-green); color: var(--color-green-deep); }
  .guide-more { font-size: .9rem; margin: 0; }

  .cmp-cta { white-space: normal; }
  .cmp-cta .offer { display: block; margin-top: .35rem; white-space: normal; line-height: 1.3; }

  .tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem; margin: 1rem 0; }
  .tool-card { border: 1px solid var(--color-rule-strong); border-radius: 4px; padding: 1rem 1.1rem;
    background: var(--color-paper); display: flex; flex-direction: column; gap: .35rem; }
  .tool-head { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .tool-name { font-weight: 800; font-size: 1.12rem; text-decoration: none; color: var(--color-ink); }
  .tool-name:hover { color: var(--color-green-deep); text-decoration: underline; }
  .tag { font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700;
    color: var(--color-green-deep); border: 1px solid var(--color-rule-strong); border-radius: 999px;
    padding: .05rem .45rem; }
  .tool-price { margin: 0; font-weight: 700; color: var(--color-green-deep); font-size: .95rem; }
  .tool-best { margin: 0; color: var(--color-muted); font-size: .88rem; flex: 1; }
  .tool-actions { display: flex; gap: .8rem; align-items: center; margin-top: .4rem; }
  .btn-visit { display: inline-block; background: var(--color-green-deep); color: #fff; font-weight: 700;
    text-decoration: none; padding: .4rem .75rem; border-radius: 3px; font-size: .85rem; }
  .btn-visit:hover { background: var(--color-green); }
  .link-review { font-size: .85rem; font-weight: 600; }
  .offer { margin: 0; font-size: .75rem; font-weight: 700; color: var(--color-green-deep); }
  .empty { color: var(--color-muted); font-style: italic; }
</style>
