---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/categories';

interface Props {
  category: string; // category slug
}
const { category } = Astro.props;
const meta = CATEGORIES[category];

const platforms = (await getCollection('platforms', ({ data }) => data.draft === false))
  .filter((p) => p.data.category === category)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const posts = (await getCollection('posts', ({ data }) => data.draft === false))
  .filter((p) => p.data.platformsMentioned.some((s) => platforms.find((pl) => pl.data.slug === s)))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);
---
<div class="prose">
  <h2>Tools we cover</h2>
  {platforms.length === 0 ? (
    <p class="empty">Platform write-ups for {meta?.label.toLowerCase()} are in the pipeline.</p>
  ) : (
    <ul class="tool-list">
      {platforms.map((p) => (
        <li>
          <a href={`/platforms/${p.data.slug}/`}>{p.data.name}</a>
          {p.data.freeTier && <span class="tag">free tier</span>}
          <span class="tool-best">{p.data.bestFor}</span>
        </li>
      ))}
    </ul>
  )}

  {posts.length > 0 && (
    <>
      <h2>Related reading</h2>
      <ul>
        {posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
      </ul>
    </>
  )}
</div>
<style>
  .tool-list { list-style: none; padding: 0; }
  .tool-list li { padding: .8rem 0; border-bottom: 1px solid var(--color-rule); }
  .tool-list a { font-size: 1.15rem; font-weight: 600; }
  .tool-best { display: block; color: var(--color-muted); font-size: .92rem; }
  .tag { font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--color-green-deep); border: 1px solid var(--color-rule-strong); border-radius: 999px;
    padding: .05rem .45rem; margin-left: .5rem; }
  .empty { color: var(--color-muted); font-style: italic; }
</style>
